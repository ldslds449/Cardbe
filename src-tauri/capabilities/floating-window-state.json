{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-window-state",
  "description": "Persist floating window positions after dragging",
  "windows": [
    "float-task-*",
    "float-focus-*",
    "widget-task-*",
    "widget-focus-*"
  ],
  "permissions": ["window-state:allow-save-window-state"]
}
