{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cardbe",
  "version": "0.8.0",
  "identifier": "com.malecat.cardbe",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cardbe",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": true
      },
      {
        "label": "quick-task",
        "title": "New Task · Cardbe",
        "url": "/quick-add?mode=task",
        "width": 480,
        "height": 410,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "quick-note",
        "title": "New Note · Cardbe",
        "url": "/quick-add?mode=note",
        "width": 480,
        "height": 270,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../LICENSE",
      "../NOTICE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "e794e04c-ae27-4d9f-8c71-31107af7d84c"
      }
    }
  }
}
