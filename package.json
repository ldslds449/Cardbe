{
  "name": "cardbe",
  "version": "1.6.0",
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "vp fmt && cargo fmt --manifest-path src-tauri/Cargo.toml && cargo fmt --manifest-path src-tauri/test-fixtures/runtime-fixture/Cargo.toml",
    "format:check": "vp fmt --check && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo fmt --check --manifest-path src-tauri/test-fixtures/runtime-fixture/Cargo.toml",
    "lint": "vp lint && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && cargo clippy --manifest-path src-tauri/test-fixtures/runtime-fixture/Cargo.toml --locked -- -D warnings",
    "lint:fix": "vp lint --fix && cargo clippy --fix --allow-dirty --manifest-path src-tauri/Cargo.toml --locked --all-targets && cargo clippy --fix --allow-dirty --manifest-path src-tauri/test-fixtures/runtime-fixture/Cargo.toml --locked",
    "dev": "node scripts/dev.mjs",
    "frontend:dev": "vp dev",
    "frontend:build": "vp build",
    "frontend:preview": "vp preview",
    "frontend:test": "vp test run",
    "frontend:test:watch": "vp test",
    "test": "pnpm frontend:test && pnpm plugins:test && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "plugins:test": "node scripts/build-plugins.mjs",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules --emit-ts-declarations --strategy custom-cardbe baseLocale",
    "check": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm format:check && pnpm lint",
    "check:watch": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/tauri.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@dnd-kit-svelte/core": "^0.0.11",
    "@dnd-kit-svelte/modifiers": "^0.0.11",
    "@dnd-kit-svelte/sortable": "^0.0.11",
    "@dnd-kit-svelte/svelte": "^0.1.6",
    "@dnd-kit-svelte/utilities": "^0.0.11",
    "@dnd-kit/abstract": "^0.2.4",
    "@dnd-kit/dom": "^0.2.4",
    "@lucide/svelte": "^1.61.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/svelte-virtual": "^3.13.48",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-notification": "~2.7.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@xyflow/svelte": "^1.7.0",
    "katex": "^0.18.10",
    "mode-watcher": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pele": "^1.9.0",
    "remark-math": "^6.0.0",
    "svelte-exmarkdown": "^5.0.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.29.1",
    "@inlang/plugin-message-format": "^4.5.5",
    "@internationalized/date": "^3.12.4",
    "@shikijs/rehype": "^4.5.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
