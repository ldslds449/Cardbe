{
  "name": "cardbe",
  "version": "0.8.0",
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "lint": "biome lint --only=style/useBlockStatements . && cargo clippy --manifest-path src-tauri/Cargo.toml --locked",
    "lint:fix": "biome lint --only=style/useBlockStatements --write . && cargo clippy --fix --allow-dirty --manifest-path src-tauri/Cargo.toml --locked",
    "dev": "node scripts/dev.mjs",
    "frontend:dev": "vite dev",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview",
    "frontend:test": "vitest run",
    "frontend:test:watch": "vitest",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm format:check && pnpm lint",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "node scripts/tauri.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@dnd-kit-svelte/core": "^0.0.11",
    "@dnd-kit-svelte/modifiers": "^0.0.11",
    "@dnd-kit-svelte/sortable": "^0.0.11",
    "@dnd-kit-svelte/svelte": "^0.1.3",
    "@dnd-kit-svelte/utilities": "^0.0.11",
    "@dnd-kit/abstract": "^0.1.21",
    "@lucide/svelte": "^0.561.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "mode-watcher": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "svelte-exmarkdown": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "@internationalized/date": "^3.10.1",
    "@shikijs/rehype": "^3.17.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.3.3",
    "bits-ui": "^2.14.4",
    "clsx": "^2.1.1",
    "shiki": "^3.17.0",
    "svelte": "^5.55.7",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^1.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
