# Dependencies and generated frontend output
node_modules/
/src/lib/paraglide/
/project.inlang/cache/
.pnpm-store/
/build/
/.svelte-kit/
/.svelte-kit-dev-*/
/package/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust and Tauri generated output (the nested .gitignore also covers /target)
/src-tauri/target/
/src-tauri/gen/schemas/

# Local configuration and secrets. Commit only documented example files.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision

# Local data, exports, backups, and logs that may contain task content
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.backup
*.bak
*.log
/.cardbe-debug/

# Editor and operating-system files
.vscode/
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.vitest/

# Plugin component build outputs
/plugins/*/target/
/plugins/*/dist/
/src-tauri/test-fixtures/**/target/
/src-tauri/test-fixtures/**/dist/
